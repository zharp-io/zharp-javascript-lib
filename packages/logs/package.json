{
  "name": "@zharp/logs",
  "version": "1.2.3",
  "description": "Logging and zero-config error capture for JavaScript and TypeScript — browser, Node.js, and React Native",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./init": {
      "types": "./init.d.ts",
      "import": "./init.mjs",
      "require": "./init.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./init.js",
    "./init.mjs"
  ],
  "files": [
    "dist",
    "init.js",
    "init.mjs",
    "init.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "zharp",
    "logging",
    "logs",
    "monitoring",
    "observability",
    "sdk",
    "error-tracking",
    "winston",
    "pino",
    "nestjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zharp-io/zharp-javascript-lib.git",
    "directory": "packages/logs"
  },
  "homepage": "https://zharp.io/docs/sdks/logs",
  "bugs": "https://github.com/zharp-io/zharp-javascript-lib/issues",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@zharp/internal": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
