{
  "name": "@zharp/cli",
  "version": "0.1.0",
  "description": "Zharp's command line: upload source maps, ProGuard mappings, Dart symbols and dSYMs for readable stack traces",
  "bin": {
    "zharp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "zharp",
    "sourcemaps",
    "source-maps",
    "debug-id",
    "proguard",
    "r8",
    "dsym",
    "flutter",
    "symbolication",
    "error-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zharp-io/zharp-javascript-lib.git",
    "directory": "packages/cli"
  },
  "homepage": "https://zharp.io/docs/sourcemaps",
  "bugs": "https://github.com/zharp-io/zharp-javascript-lib/issues",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
