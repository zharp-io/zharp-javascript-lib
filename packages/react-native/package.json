{
  "name": "@zharp/react-native",
  "version": "0.1.0",
  "description": "Zharp Application Monitoring for React Native and Expo — errors, logs, traces, sessions",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "zharp",
    "react-native",
    "expo",
    "apm",
    "crash-reporting",
    "error-tracking",
    "tracing",
    "logging",
    "opentelemetry",
    "monitoring",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zharp-io/zharp-javascript-lib.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://zharp.io/docs/sdks/react-native",
  "bugs": "https://github.com/zharp-io/zharp-javascript-lib/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@zharp/internal": "workspace:*",
    "react": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  }
}
