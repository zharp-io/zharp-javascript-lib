// The Worker the unit tests run (inside workerd, through @cloudflare/vitest-plugin).
{
  "name": "zharp-cloudflare-test",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "shop", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "kv_namespaces": [{ "binding": "KV", "id": "kv-test" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "files" }],
  "queues": { "producers": [{ "binding": "QUEUE", "queue": "orders" }] },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
