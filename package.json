{
  "name": "@zharp/logs",
  "version": "1.3.0",
  "description": "Logging and distributed tracing SDK for JavaScript and TypeScript — browser, Node.js, and React Native",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.mjs",
      "require": "./dist/replay.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "keywords": [
    "zharp",
    "logging",
    "monitoring",
    "observability",
    "sdk",
    "tracing",
    "apm",
    "opentelemetry",
    "distributed-tracing",
    "breadcrumbs",
    "error-tracking",
    "session-replay",
    "rrweb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zharp/zharp-js-sdk"
  },
  "homepage": "https://zharp.io/docs/sdks/js",
  "bugs": "https://github.com/zharp/zharp-js-sdk/issues",
  "devDependencies": {
    "@rrweb/types": "^2.1.1",
    "@types/node": "^25.9.3",
    "jsdom": "^24.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "rrweb": "^2.1.1"
  }
}
